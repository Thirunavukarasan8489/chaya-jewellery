# Copy this file to .env.local and fill in real values.
# .env.local (and every other .env* file) is git-ignored — see .gitignore.

# --- Database -----------------------------------------------------------
# MongoDB Atlas (or any Mongo) connection string. Required — lib/db.ts throws
# on startup if this is missing.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# --- Auth (NextAuth) ------------------------------------------------------
# Secret used to sign/encrypt the NextAuth JWT session. lib/authOptions.ts and
# proxy.ts fall back to a hardcoded dev secret when this is unset — fine for
# local dev, never rely on that fallback in production.
NEXTAUTH_SECRET=

# --- Razorpay (checkout payments) -----------------------------------------
# Server-side key pair, used to create Razorpay orders (lib/services/payment.ts).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Signing secret for the Razorpay webhook (app/api/webhooks/razorpay/route.ts),
# which verifies payment.captured events and finalizes inventory/order status.
RAZORPAY_WEBHOOK_SECRET=
# Client-side Razorpay key, exposed to the browser checkout widget.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Signing secret for the generic/legacy payment webhook
# (app/api/webhooks/payment/route.ts, PaymentService.verifyWebhookSignature).
# Separate from RAZORPAY_WEBHOOK_SECRET above — that route is not Razorpay-specific.
PAYMENT_WEBHOOK_SECRET=

# --- Cloudinary (product/media uploads) ------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Same cloud name, exposed to the browser — required by next-cloudinary's
# <CldImage> (used in product-card.tsx, ProductsTable.tsx,
# ProductVariantsTable.tsx), which runs client-side and reads this
# NEXT_PUBLIC_ var directly even when passed a full secure_url as src.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- SMTP (transactional email — order confirmations, password resets, etc.) -
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Chaya Jewellery <no-reply@chayajewellery.com>"

# --- Cron (Vercel Cron auth) ------------------------------------------------
# Bearer token app/api/cron/release-inventory checks for, so the endpoint that
# cancels stale PAYMENT_PENDING orders can't be triggered by anyone else.
CRON_SECRET=

# --- Analytics ---------------------------------------------------------
NEXT_PUBLIC_GA_ID=
